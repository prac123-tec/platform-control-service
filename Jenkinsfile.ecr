@Library('enterprise-library') _

pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build Docker Image') {
            steps {
                buildDockerImage()
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                loginToECR()
            }
        }

        stage('Tag Docker Image') {
            steps {
                tagDockerImage()
            }
        }

        stage('Push Docker Image') {
            steps {
                pushDockerImage()
            }
        }

    }
}
